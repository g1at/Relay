{
  "name": "relay",
  "version": "3.0.1",
  "description": "Relay - 个人 AI 助手",
  "main": "main.js",
  "author": "g0at",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g1at/Relay.git"
  },
  "homepage": "https://github.com/g1at/Relay#readme",
  "bugs": {
    "url": "https://github.com/g1at/Relay/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "test:ui": "electron test/ui-smoke.cjs",
    "test:workspace": "electron test/workspace-navigation-smoke.cjs",
    "test:sidebar": "electron test/sidebar-layout-smoke.cjs",
    "test:sidebar-navigation": "electron test/sidebar-navigation-smoke.cjs",
    "test:window-chrome": "electron test/window-chrome-smoke.cjs",
    "test:mini-chat": "electron test/mini-chat-smoke.cjs",
    "test:mini-windows": "electron test/mini-window-host-smoke.cjs",
    "test:provider-runtime": "node test/provider-runtime-smoke.cjs",
    "test:sdk-input-priority": "node test/sdk-input-priority-smoke.cjs",
    "test:provider-model-policy": "node test/provider-model-policy-smoke.cjs",
    "test:provider-editor": "electron test/provider-editor-smoke.cjs",
    "test:scheduler-ui": "electron test/scheduler-page-smoke.cjs",
    "test:plugins": "electron test/plugins-page-smoke.cjs",
    "test:skill-draft-ui": "electron test/skill-draft-ui-smoke.cjs",
    "test:plugins-polish": "electron test/plugins-polish-smoke.cjs",
    "test:responsive-layout": "electron test/responsive-layout-smoke.cjs",
    "test:agent-entry": "electron test/agent-entry-smoke.cjs",
    "test:keyboard-shortcuts": "electron test/keyboard-shortcuts-smoke.cjs",
    "test:settings-details": "electron test/settings-detail-smoke.cjs",
    "prepare:sdk-runtime": "node build/ensure-sdk-linux-runtime.js",
    "build": "npm run verify:installer-skin && npm run prepare:sdk-runtime && electron-builder --win",
    "build:dir": "npm run prepare:sdk-runtime && electron-builder --win --dir",
    "release": "node build/release.cjs",
    "release:publish": "node build/release.cjs --publish",
    "test:workspace-pty": "electron test/workspace-pty-smoke.cjs",
    "test:workspace-ipc": "electron test/workspace-ipc-smoke.cjs",
    "test:workspace-asar": "node test/workspace-asar-fixture.cjs && electron test/workspace-asar-smoke.cjs",
    "test:workspace-panel": "electron test/workspace-panel-smoke.cjs",
    "test:workspace-review": "electron test/workspace-review-smoke.cjs",
    "test:workspace-files": "electron test/workspace-file-preview-smoke.cjs",
    "test:file-layout": "electron test/workspace-file-layout-smoke.cjs",
    "test:scrollbars": "electron test/scrollbars-smoke.cjs",
    "test:browser-host": "electron test/browser-panel-host-smoke.cjs",
    "test:browser-ipc": "electron test/browser-panel-ipc-smoke.cjs",
    "test:browser-profile": "electron test/browser-profile-smoke.cjs",
    "test:browser-settings": "electron test/browser-settings-page-smoke.cjs",
    "test:workspace-browser": "electron test/workspace-tabs-browser-smoke.cjs",
    "test:read-only-surfaces": "electron test/read-only-surfaces-smoke.cjs",
    "test:conversation-controls": "electron test/conversation-controls-smoke.cjs",
    "test:activity-grouping": "electron test/activity-grouping-smoke.cjs",
    "test:crash-progress": "electron test/crash-progress-smoke.cjs",
    "test:progress-asar": "electron test/task-progress-asar-smoke.cjs",
    "test:noninterrupt-steering": "electron test/noninterrupt-steering-smoke.cjs",
    "test:model-controls": "electron test/model-controls-smoke.cjs",
    "test:projects-composer": "electron test/projects-composer-smoke.cjs",
    "test:composer-menu": "electron test/composer-menu-smoke.cjs",
    "test:native-attachments": "electron test/native-attachment-dialog-smoke.cjs",
    "test:sidebar-project-limits": "electron test/sidebar-project-limits-smoke.cjs",
    "test:usage-ui": "electron test/usage-page-smoke.cjs",
    "test:profile-ui": "electron test/profile-page-smoke.cjs",
    "test:memory-ui": "electron test/memory-page-smoke.cjs",
    "build:installer-skin": "node build/build-installer-skin.cjs",
    "verify:installer-skin": "node build/verify-installer-skin.cjs",
    "test:installer": "node --test test/installer-handoff.test.js test/installer-nsis-lifecycle.test.cjs && node test/installer-nsis-ui-smoke.cjs && node test/installer-nsis-pages-smoke.cjs && node test/installer-nsis-pages-smoke.cjs --chrome-close && node test/installer-nsis-build.cjs && electron test/installer-welcome-smoke.cjs",
    "build:taskbar-overlay": "node build/build-taskbar-overlay.cjs",
    "build:taskbar-badges": "electron build/generate-taskbar-badges.cjs",
    "test:taskbar-badges": "electron test/taskbar-completion-badge-smoke.cjs",
    "test:packaged-app": "electron test/packaged-application-smoke.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.266",
    "@anthropic-ai/sdk": "0.115.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "^6.3.9",
    "node-pty": "1.1.0",
    "zod": "4.4.3",
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.relay.app",
    "productName": "Relay",
    "executableName": "Relay",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "g1at",
      "repo": "Relay"
    },
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "removePackageScripts": true,
    "beforePack": "./build/verify-sdk-packaging.cjs",
    "files": [
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "main.js",
      "src/main/**/*.js",
      "src/main/**/*.cjs",
      "preload.js",
      "browser-page-preload.js",
      "renderer/**/*",
      "installer/**/*",
      "!**/*.map",
      "!**/{.DS_Store,Thumbs.db}",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      {
        "from": "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64",
        "to": "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@anthropic-ai/claude-agent-sdk-linux-x64",
        "to": "node_modules/@anthropic-ai/claude-agent-sdk-linux-x64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "legal",
        "filter": [
          "LICENSE",
          "NOTICE",
          "THIRD_PARTY_NOTICES.md",
          "licenses/**/*",
          "renderer/vendor/*LICENSE"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon-dark.ico",
        "to": "icon-dark.ico"
      }
    ],
    "asarUnpack": [
      "src/main/app/paths.js",
      "src/main/tasks/task-progress-worker.js",
      "src/main/tasks/task-progress-store.js",
      "src/main/tasks/task-protocol.js",
      "renderer/activity-stream.js",
      "renderer/assistant-output.js",
      "renderer/task-continuity.js",
      "src/main/skills/skill-draft-worker.js",
      "src/main/skills/skill-draft-service.js",
      "src/main/sdk/sdk-native-events.js",
      "src/main/skills/skill-usage-worker.js",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/**",
      "node_modules/node-pty/**",
      "src/main/usage/usage-stats-service.js",
      "src/main/usage/usage-stats-worker.js",
      "src/main/sdk/sdk-settings-probe.cjs",
      "src/main/sdk/sdk-runtime-policy.js",
      "src/main/sdk/relay-instructions.js",
      "node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs",
      "src/main/sdk/sdk-session-history.js",
      "src/main/sdk/sdk-session-history-worker.cjs",
      "src/main/sdk/sdk-task-resources.js",
      "src/main/sdk/sdk-runtime-preferences.js",
      "renderer/taskbar-badges/native/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "unicode": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "asar": true,
    "compression": "maximum"
  }
}
