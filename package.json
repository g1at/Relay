{
  "name": "relay",
  "version": "2.0.0",
  "description": "Relay - 个人 AI 助手",
  "main": "main.js",
  "author": "g0at",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.115.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "^6.3.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.relay.app",
    "productName": "Relay",
    "executableName": "Relay",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "g1at",
      "repo": "relay-updates"
    },
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "removePackageScripts": true,
    "files": [
      "main.js",
      "preload.js",
      "claude-sdk.js",
      "skill-usage-worker.js",
      "scheduler.js",
      "updater.js",
      "logger.js",
      "cron-mcp.js",
      "renderer/**/*",
      "installer/**/*",
      "!**/*.map",
      "!**/{.DS_Store,Thumbs.db}",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "extraResources": [
      {
        "from": "extra-resources/",
        "to": "extra-resources/"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "skill-usage-worker.js",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "unicode": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "asar": true,
    "compression": "maximum"
  }
}
